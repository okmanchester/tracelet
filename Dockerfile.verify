FROM python:3.12-slim

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/backend
COPY backend/pyproject.toml ./
RUN python -c "import tomllib; p=tomllib.load(open('pyproject.toml','rb'))['project']; open('/tmp/verify-requirements.txt','w').write('\n'.join(p['dependencies']+p['optional-dependencies']['dev']))" \
    && python -m pip install --no-cache-dir -r /tmp/verify-requirements.txt
COPY backend/app ./app
RUN python -m pip install --no-cache-dir --no-deps .

COPY backend/scripts ./scripts
COPY backend/eval ./eval
COPY backend/benchmark ./benchmark
COPY backend/tests ./tests
COPY backend/alembic.ini ./
COPY backend/migrations ./migrations
COPY Makefile /workspace/Makefile
