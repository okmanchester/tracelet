!backend/eval/**
!backend/benchmark/
!backend/benchmark/**
!backend/tests/
!backend/tests/**
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.env
**/.env.*
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
