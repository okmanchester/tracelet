# ===== Provider 选择（改完需重启进程）=====
LLM_CHAT_PROVIDER=deepseek          # deepseek | dashscope | openai_compat
EMBEDDING_PROVIDER=local            # local | dashscope | openai_compat
RERANK_PROVIDER=local               # local | dashscope
LLM_TIMEOUT_SECONDS=60

# ----- Chat: DeepSeek（OpenAI 兼容）-----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_SMALL=deepseek-flash
DEEPSEEK_MODEL_LARGE=deepseek-v4-pro

# ----- Embedding / Rerank: 本地 BGE -----
# EMBEDDING_DIM 必须与 Milvus collection 的向量维度一致
EMBEDDING_DIM=1024
LOCAL_EMBEDDING_MODEL_PATH=D:/WorkSpace/AIModels/BAAI/bge-large-zh-v1.5
LOCAL_EMBEDDING_DEVICE=auto         # auto | cpu | cuda
LOCAL_EMBEDDING_BATCH_SIZE=16
LOCAL_EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
LOCAL_RERANK_MODEL_PATH=D:/WorkSpace/AIModels/BAAI/bge-reranker-base
LOCAL_RERANK_DEVICE=auto            # auto | cpu | cuda
LOCAL_RERANK_BATCH_SIZE=16

# ----- 可选备用：DashScope -----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_SMALL=qwen-turbo
DASHSCOPE_MODEL_LARGE=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_RERANK_MODEL=gte-rerank-v2

# ----- 可选备用：任意 OpenAI 兼容厂商 -----
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL_SMALL=
OPENAI_COMPAT_MODEL_LARGE=
OPENAI_COMPAT_EMBEDDING_MODEL=

# ===== 基础设施 =====
# 注：宿主机端口已错开常用端口，避免与本机其它服务冲突
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=devsupport
MYSQL_PASSWORD=devsupport123
MYSQL_DB=devsupport

MILVUS_URI=http://localhost:19531
MILVUS_COLLECTION=knowledge_chunk

REDIS_URL=redis://localhost:6380/0

# ===== 认证 =====
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ===== 业务阈值 =====
INTENT_CONFIDENCE_THRESHOLD=0.6
RAG_SCORE_THRESHOLD=0.3
RAG_VEC_HIT_THRESHOLD=0.45
TOOL_TIMEOUT_SECONDS=3
SEMANTIC_CACHE_SIM_THRESHOLD=0.95

# ===== 其它 =====
# 试用使用 pilot：禁止评估/压测；仅 dev/test/eval 允许离线任务，仍需独立依赖。
APP_ENV=dev
LOG_LEVEL=INFO
